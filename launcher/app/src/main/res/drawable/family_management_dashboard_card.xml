<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1D2D43" />
            <stroke android:width="2dp" android:color="#FF76B8FF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF22334B" />
            <stroke android:width="1dp" android:color="#FF52769D" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1E2B3F" />
            <stroke android:width="1dp" android:color="#FF34465D" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>
