<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF34516B" />
            <stroke android:width="2dp" android:color="#FFF1F6FB" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#35FFFFFF" android:endColor="#1CFFFFFF" />
            <stroke android:width="1dp" android:color="#58FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
